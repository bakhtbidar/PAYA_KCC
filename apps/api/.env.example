# Local dev uses SQLite (zero install). Point this at a real Postgres URL in staging/production,
# e.g. postgresql://user:password@host:5432/paya_control
DATABASE_URL="file:./dev.db"

JWT_ACCESS_SECRET="dev-only-change-me-access-secret"
JWT_REFRESH_SECRET="dev-only-change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="7"

PORT=3001
WEB_ORIGIN="http://localhost:5173"
PUBLIC_APP_URL="http://localhost:5173"

# STORAGE_PROVIDER=local writes uploaded files to UPLOAD_DIR on disk (dev only — most
# hosts, including Render, don't persist local disk across deploys). Set to "s3" and fill
# in the S3_* vars below to use an S3-compatible bucket instead — see .env.production.example.
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"

# Seed credentials (dev only — change before any shared/staging use)
SEED_ADMIN_EMAIL="admin@paya.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
