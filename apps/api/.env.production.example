# Reference only — on Render these are set in the dashboard (render.yaml wires most of
# them up automatically; a few are marked `sync: false` there and need to be filled in by
# hand). This file just documents what each one is and where it comes from. See DEPLOYMENT.md.

NODE_ENV="production"

# Render fills this in automatically from the attached Postgres database (render.yaml's
# `fromDatabase` reference) — you shouldn't need to set it by hand.
DATABASE_URL="postgresql://user:password@host:5432/paya_control"

# Render generates these automatically on first deploy (render.yaml's `generateValue: true`).
# If you ever need to rotate them by hand: any long random string works, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="7"

PORT=3001

# The web app's real URL (your custom domain, once attached — see DEPLOYMENT.md).
WEB_ORIGIN="https://app.payaops.com"
PUBLIC_APP_URL="https://app.payaops.com"

# File storage — Cloudflare R2 (S3-compatible, free up to 10GB, no egress fees).
STORAGE_PROVIDER="s3"
# From R2's bucket page: "S3 API" endpoint, looks like
# https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_BUCKET="paya-control-documents"
# From R2 → "Manage API tokens" → create a token scoped to this bucket only.
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"

# The real first login for your production deployment. The app refuses to boot in
# production without SEED_ADMIN_PASSWORD set — this is deliberate, so a real deployment
# can never silently end up using the well-known dev default password.
SEED_ADMIN_EMAIL="you@payaops.com"
SEED_ADMIN_PASSWORD=""

# Demo data (fake restaurant, fake users) defaults to off automatically when
# NODE_ENV=production. Leave this unset unless you specifically want it seeded anyway.
# SEED_DEMO_DATA="false"
